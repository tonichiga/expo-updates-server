# OTA signing (optional)
CODE_SIGNING_PRIVATE_KEY=""

# Feature flags (optional)
FLAGS=""
FLAGS_SECRET=""

# Database
DATABASE_PROVIDER="pg"
DATABASE_URL="postgresql://user:password@host:5432/database"
DATABASE_SSL="false"

# Cloudflare R2 or another S3-compatible storage
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="<access-key-id>"
R2_SECRET_ACCESS_KEY="<secret-access-key>"
R2_BUCKET="expo-updates"
R2_REGION="auto"

# OTA storage
OTA_STORAGE_BUCKET="expo-updates"
OTA_SIGNED_URL_TTL="3600"
OTA_PUBLIC_BASE_URL="https://updates.example.com"
# Deprecated compatibility setting. New manifests always use gated /api/assets
# URLs so the global OTA emergency switch cannot be bypassed.
OTA_CDN_BASE_URL=""

# Supabase provider
SUPABASE_PROJECT_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHED_KEY=""
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_SIGNED_URL_TTL="3600"
SUPABASE_UPDATES_BUCKET="expo-updates"

# Optional Cloudflare/Vercel integration
CF_API_TOKEN=""
VERCEL_OIDC_TOKEN=""
