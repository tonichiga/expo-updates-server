# Expo update selection
EXPO_UPDATE_CHANNEL=production

# Authenticated embedded-build registration
OTA_SERVER_URL=https://updates.example.com
OTA_ACCESS_TOKEN=

# Direct publisher database access
OTA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
OTA_DATABASE_SSL=true

# S3-compatible update storage
R2_ENDPOINT=https://storage.example.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=expo-updates
R2_REGION=auto
S3_FORCE_PATH_STYLE=false
